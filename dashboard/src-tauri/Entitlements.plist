<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Signing with a real identity turns on the hardened runtime, which
         blocks microphone capture unless it is declared here. The ad-hoc
         builds did not need this. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>

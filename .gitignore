.env
__pycache__/
*.pyc
.venv/
venv/
*.db
.DS_Store
*.egg-info/

# Gmail/Calendar MCP credential files — should live in ~/.gmail-mcp/ outside
# the repo, but ignored here too as a safety net in case one lands in-tree.
gcp-oauth.keys.json
credentials.json
tokens.json
.gmail-mcp/
.config/google-calendar-mcp/

# Conversation memory (SQLite checkpointer) — private conversation history,
# incl. anything the email/calendar tools pulled into context. *.db above
# does not match .sqlite, which is what memory.py actually writes.
# WAL-mode journal files (-shm/-wal) are separate filename suffixes that
# *.sqlite alone doesn't match — surfaced as untracked files by real daemon
# use during Phase 8 testing (STEPS.md 53).
*.sqlite
*.sqlite-shm
*.sqlite-wal

# SqliteSaver's own checkpoint/metadata blobs use a distinct
# `<dbname>.sqlite-x-checkpoints-<id>-{checkpoint,metadata}.bin` naming
# pattern that none of the globs above catch — found as untracked private
# conversation-history files during a real commit pass (2026-08-08).
*.sqlite-x-checkpoints-*.bin

# cost_cache.py's own durable /cost fallback (last-known-good Langfuse
# figures) — runtime state, same category as the *.sqlite stores above.
cost_cache.json

# vault_search.py's cached note embeddings (backlog Section 3 feature,
# STEPS.md 150) — a derived, rebuildable cache keyed by content hash, same
# runtime-state category as cost_cache.json above.
vault_embeddings_cache.npz

# conversation_search.py's cached thread embeddings (STEPS.md 151/152) —
# same derived, rebuildable-cache category as vault_embeddings_cache.npz
# above, just a different corpus.
conversation_embeddings_cache.npz

# LangGraph Studio (`langgraph dev`) local runtime state
.langgraph_api/

# Claude Code session state — includes isolated worktrees for background
# jobs, which are themselves separate git repos and must never be added as
# gitlinks to this one.
.claude/

# Obsidian notes-app config — personal editor state, not project content.
.obsidian/

# Astryx redesign sandbox — throwaway exploration of theme/layout concepts
# against the desktop wallpaper's ember palette, superseded by the real
# integration into dashboard/ (oniMatchaTheme, KanbanBoard, HomePage, etc.).
# Not part of the shipped app; never intended to enter the repo history.
oni/

# Instrument redesign sandbox — Obsidian-violet dashboard mockup (static
# HTML/CSS/JS, no React) + its own handoff brief for porting into
# dashboard/. Not part of the shipped app; never intended to enter history.
instrument/

# Claude Code skill-install artifacts — same standing policy as Phase 11's
# skill-vetting cleanup (CLAUDE.md's security model): a skill is untrusted,
# instruction-bearing content loaded into agent context, and install
# artifacts must never enter this portfolio repo's history.
.agents/
skills-lock.json

# The user's own real profile (name, phone numbers, family members' phone
# numbers, location) — the assistant reads this locally for memory/context,
# but this repo is public on GitHub (CLAUDE.md: "treat it as a portfolio
# piece"), so it must never be committed. Found untracked and deliberately
# excluded from a commit during Phase 25's build (STEPS.md 117-118); added
# here so it can't land in history by accident later.
workspace/

# Nova superagent — a separate, unrelated ServiceNow/AWS-Bedrock multi-agent
# codebase (Docker/Redis) dropped in for reference only (its widget_signal
# tool's flat form-field contract, as a design comparison for this project's
# own render_ui). Not this project's code, not meant to enter this portfolio
# repo's history.
nova-superagent-agent-main/
nova-superagent-agent-main.zip



# Vault sync API bearer token (assistant/vault_sync.py) — a secret, like .env.
.vault_token
.vault_token.tmp

# OniCore (iPhone app logic) build output
ios/OniCore/.build/
ios/OniCore/.swiftpm/

# Oni promo video: the finished video is linked from the README, so the whole
# working directory (sources, assets, renders) stays local.
video/

# iPhone app: the .xcodeproj is generated from ios/project.yml; Local.xcconfig is personal.
ios/Oni.xcodeproj/
ios/Config/Local.xcconfig
ios/DerivedData/
*.xcuserstate
xcuserdata/
# The app source dir would otherwise match the sandbox rule "oni/" above (case-insensitive).
!/ios/Oni/
